# Template only — do NOT put real values here or commit this file with real
# values. Copy it, fill it in, and create the Secret from the copy:
#
#   cp k8s/secret.env.example k8s/secret.env
#   # edit k8s/secret.env with real values
#   kubectl create secret generic helix-secrets -n helix --from-env-file=k8s/secret.env
#
# k8s/secret.env is already covered by the repo's .gitignore (`*.env`).

GROQ_API_KEY=your-groq-key
COHERE_API_KEY=your-cohere-key

# label:key pairs, comma-separated — see app/auth.py. Required because
# API_KEY_REQUIRED=true in the ConfigMap for production.
API_KEYS=alice:sk-live-changeme

# Optional — leave blank to disable.
LOGFIRE_TOKEN=
QDRANT_API_KEY=
REDIS_PASSWORD=
