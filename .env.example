# --- Ingestion / infrastructure ---
# Redis: Celery broker + result backend (docker-compose service "redis")
REDIS_URL=redis://localhost:6379/0

# Qdrant: vector store (docker-compose service "qdrant")
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Embedding model used for both chunking (tokenizer) and vectors
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
TOP_K=4
# Min cosine score for a chunk to count as relevant; below it → abstain/off-topic.
RETRIEVAL_SCORE_THRESHOLD=0.4

# Reranking (Cohere). Without COHERE_API_KEY it falls back to vector order.
RERANK_ENABLED=true
COHERE_API_KEY=your-cohere-key
RERANKER_MODEL=rerank-english-v3.0
RERANK_CANDIDATES=20
RERANK_TOP_K=4

# --- LLM (any OpenAI-compatible provider; see app/llm.py PROVIDERS) ---
# Known names: groq, openrouter, openai, together, fireworks, ollama.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key
# Optional overrides — point at any OpenAI-compatible endpoint (vLLM, LiteLLM,
# a gateway). LLM_API_KEY wins over the provider's own key variable above.
# LLM_BASE_URL=
# LLM_API_KEY=

# Models by role. These IDs are Groq's — change them when you change provider.
# chat: answers and conversation. fast: the router (a 4-token classification).
# guard: the input safety classifier.
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_GUARD_MODEL=openai/gpt-oss-safeguard-20b
# Tried in order after the role's model fails (client-side, works on any provider).
LLM_FALLBACKS=qwen/qwen3.6-27b,openai/gpt-oss-20b

# --- API ---
# Per-user chat rate limit (sliding window, keyed by X-User-Id header or IP).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_QUESTION_CHARS=2000

# Input safety guardrail (LLM_GUARD_MODEL above). Skipped without an API key.
GUARDRAIL_ENABLED=true
# On classifier errors or unparseable verdicts: false = allow (default),
# true = refuse. Fail-open keeps a model outage from taking the API down.
GUARDRAIL_FAIL_CLOSED=false

# --- Observability ---
ENVIRONMENT=development

# Logfire (full-stack tracing incl. LLM calls).
# Local UI: export spans to the Jaeger container (view at localhost:16686).
LOCAL_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Cloud export (optional): token from `uv run logfire auth`. Blank = no cloud.
LOGFIRE_TOKEN=
