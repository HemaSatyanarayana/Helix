# --- Ingestion / infrastructure ---
# Redis: Celery broker + result backend (docker-compose service "redis")
REDIS_URL=redis://localhost:6379/0

# Qdrant: vector store (docker-compose service "qdrant")
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Embedding model used for both chunking (tokenizer) and vectors
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM (via OpenRouter gateway) ---
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ordered fallback chain (OpenRouter tries top-to-bottom)
MODEL_FALLBACKS=anthropic/claude-sonnet-4.5,openai/gpt-4.1,google/gemini-2.5-flash

# --- Observability ---
ENVIRONMENT=development

# Logfire (full-stack tracing incl. LLM calls).
# Local UI: export spans to the Jaeger container (view at localhost:16686).
LOCAL_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Cloud export (optional): token from `uv run logfire auth`. Blank = no cloud.
LOGFIRE_TOKEN=
